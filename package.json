{
  "name": "housingrelay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "video:studio": "remotion studio video/src/index.tsx --public-dir=video/public",
    "video:desktop": "remotion render video/src/index.tsx EvidenceRibbon public/films/evidence-ribbon.mp4 --public-dir=video/public --codec=h264 --crf=21 --concurrency=2",
    "video:mobile": "remotion render video/src/index.tsx EvidenceRibbonMobile public/films/evidence-ribbon-mobile.mp4 --public-dir=video/public --codec=h264 --crf=21 --concurrency=2"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.4",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "remotion": "^4.0.539",
    "sharp": "^0.35.5"
  }
}
